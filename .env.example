# Copy to .env and fill in. .env is git-ignored. Never paste keys into prompts, logs or commits.
# Every value is optional at boot; a provider whose key is missing is reported as "unavailable"
# by `python -m sigma.core.config` and is skipped by the router rather than crashing.

# --- Database (Neon or any Postgres 15+) ---
DATABASE_URL=postgresql://user:password@host/sigma_vi?sslmode=require

# --- Market data ---
MASSIVE_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Filings: SEC requires a descriptive User-Agent with a contact email ---
SEC_EDGAR_USER_AGENT="SIGMA VI research you@example.com"

# --- Macro ---
FRED_API_KEY=

# --- Web research ---
EXA_API_KEY=

# --- Broker: paper only. SIGMA_LIVE_TRADING must stay false until Stage 6 (spec §50). ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
SIGMA_LIVE_TRADING=false

# --- AI models: $0 setup (see config/models.toml) ---
# Gemini API free tier key from https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
# Local models through Ollama (installed by setup.ps1). Leave as is.
OLLAMA_API_BASE=http://localhost:11434
# Paid providers are NOT used. Leave these empty unless you deliberately opt in later.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Cost controls ---
# $0 mode: the router only calls models marked free; these caps are a second safety net.
SIGMA_DAILY_LLM_BUDGET_USD=0
SIGMA_PER_TASK_MAX_USD=0
